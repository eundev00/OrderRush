%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1b1bb66b788e848f4a4ce648f4d08f90, type: 3}
  m_Name: Run1_Days
  m_EditorClassIdentifier: Assembly-CSharp::OrderRush.Data.DaysData
  _runNumber: 1
  _rent: 100
  _baseTimeBarDuration: 100
  _timeBarDurationIncrease: 25
  _baseCustomers: 1
  _customerIncrease: 0
  _daysInterval: 3
  _storyDays:
  - _dayNumber: 1
    _storyText: Fresh out of culinary school, \nI sank every last coin into a small
      diner in town. \n\nNo turning back now, \nit's finally mine. \n\nFirst day
      of business.
    _event:
      _isRainy: 0
  - _dayNumber: 2
    _storyText: Made it through day one. \nStill fumbling with everything \nburned
      a steak, dropped a plate. \n\nBut something's starting to click.
    _event:
      _isRainy: 0
  - _dayNumber: 3
    _storyText: Word is it'll rain today. \nRain always seems to make customers a
      little more impatient.
    _event:
      _isRainy: 1
  - _dayNumber: 4
    _storyText: Familiar faces keep showing up. \n\nI've already got a few I'd call
      regulars.
    _event:
      _isRainy: 0
  - _dayNumber: 6
    _storyText: Word's out that a well-known influencer is stopping by today. \n\nThe
      kitchen feels a little tenser than usual \nsomething tells me it's going to
      be a busy one.
    _event:
      _isRainy: 0
